MYTENNIS_USER=
MYTENNIS_PASSWORD=

# optional
# PORT=8000
# SCRAPE_TIME=03:00
# Cloudflare Tunnel: uncomment both (with Umami too: COMPOSE_PROFILES=tunnel,analytics)
# COMPOSE_PROFILES=tunnel
# TUNNEL_TOKEN=
# Umami analytics: COMPOSE_PROFILES=analytics, a secret (openssl rand -hex 32), then the website
# id from the Umami dashboard and the public URL of its tracker
# UMAMI_PORT=3000
# UMAMI_APP_SECRET=
# UMAMI_SCRIPT_URL=https://stats.example.com/radar.js
# UMAMI_WEBSITE_ID=
# Loading times report at /perf: a token to open it (openssl rand -hex 32); unset = report off
# PERF_TOKEN=
# The site moved, and this app also serves the old address (MOVED_FROM, a hostname): there, a
# banner on every page links to MOVED_TO, and visits count as their own Umami website
# MOVED_TO=https://tennis-radar.ch
# MOVED_FROM=tennis-radar.leounghome.loan
# MOVED_FROM_UMAMI_WEBSITE_ID=

# Each feedback message by email, sent from an Outlook.com / Hotmail mailbox through Microsoft
# Graph: the app registration's Application (client) ID, then sign in once with
# `swisstennis-ranking mail-login` (docker compose exec app swisstennis-ranking --data /app/data mail-login)
# MS_CLIENT_ID=
# FEEDBACK_MAIL_TO=you@example.com

MYTENNIS_USER=
MYTENNIS_PASSWORD=

# optional
# PORT=8000
# SCRAPE_TIME=03:00
# Cloudflare Tunnel: uncomment both (with Umami too: COMPOSE_PROFILES=tunnel,analytics)
# COMPOSE_PROFILES=tunnel
# TUNNEL_TOKEN=
# Umami analytics: COMPOSE_PROFILES=analytics, a secret (openssl rand -hex 32), then the website
# id from the Umami dashboard and the public URL of its tracker
# UMAMI_PORT=3000
# UMAMI_APP_SECRET=
# UMAMI_SCRIPT_URL=https://stats.example.com/radar.js
# UMAMI_WEBSITE_ID=
